{
  "multipart": [
    {
      "apply": {
        "model": "hdfv:block/asphalt_base"
      }
    },
    {
      "when": {
        "OR": [
          {
            "paint": "none"
          },
          {
            "mask": "0|2|4|6|8|10|12|14"
          }
        ]
      },
      "apply": {
        "model": "hdfv:block/asphalt_q0"
      }
    },
    {
      "when": {
        "paint": "white|threshold",
        "mask": "1|3|5|7|9|11|13|15"
      },
      "apply": {
        "model": "hdfv:block/asphalt_q0_white"
      }
    },
    {
      "when": {
        "paint": "yellow",
        "mask": "1|3|5|7|9|11|13|15"
      },
      "apply": {
        "model": "hdfv:block/asphalt_q0_yellow"
      }
    },
    {
      "when": {
        "OR": [
          {
            "paint": "none"
          },
          {
            "mask": "0|1|4|5|8|9|12|13"
